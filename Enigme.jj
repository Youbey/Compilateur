PARSER_BEGIN(Enigme)

import java.util.HashMap;

public class Enigme {
    private static HashMap<String, Integer> symbolTable = new HashMap<>();
    private static HashMap<String, String> symbolTableString = new HashMap<>();

    public static void main(String[] args) throws ParseException {
        System.out.println("Entrez un programme 'Enigme' a parser :");
        Enigme parser = new Enigme(System.in);
        parser.programme();
        System.out.println("Programme analyse avec succes !");
    }
}

PARSER_END(Enigme)

SKIP : {
    " " | "\t" | "\n" | "\r"  // Espaces blancs
}

TOKEN : {
    < DEBUT : "dEbut" > |
    < FIN : "fin" > |
    < AFFICHERINT : "afficherInt" > |
    < AFFICHERSTRING : "afficherString" > |
    < LIREINT : "lireInt" > |
    < LIRESTRING : "lireString" > |
    < ENTIER : "entier" > |
    < CHAINE : "chaine" > |
    < SI : "si" > |
    < ALORS : "alors" > |
    < SINON : "sinon" > |
    < FINSI : "finSi" > |
    < TANTQUE : "tantQue" > |
    < FAIRE : "faire" > |
    < FINTANTQUE : "finTantQue" > |
    < POUR : "pour" > |
    < DE : "de" > |
    < A : "a" > |
    < FINPOUR : "finPour" > |
    < TRUE : "true" > |
    < FALSE : "false" > |
    < IDENTIFIANT : <LETTER> (<LETTER> | <DIGIT>)* > |
    < NUMBER : (<DIGIT>)+ > |
    < STRING : "\"" (~["\\", "\""])* "\"" > |
    < COMMENT : "//" (~["\n", "\r"])* > |
    < GT : ">" > |
    < LT : "<" > |
    < GE : ">=" > |
    < LE : "<=" > |
    < EQ : "==" > |
    < NE : "!=" > |
    < SEMICOLON : ";" >
}

MORE : {
    < LETTER : ["a"-"z", "A"-"Z", "_"] > |
    < DIGIT : ["0"-"9"] >
}

void programme() : {}
{
    {
        System.out.println("-> Entree dans programme");
    }
    <DEBUT> instructions() <FIN>
    {
        System.out.println("<- Sortie de programme");
    }
}

void instructions() : {}
{
    {
        System.out.println("-> Entree dans instructions");
    }
    (instruction() ";")*
    {
        System.out.println("<- Sortie de instructions");
    }
}

void instruction() : {}
{
    afficherInt()
    | afficherString()
    | lireInt()
    | lireString()
    | declarationVariable()
    | declarationVariableString() // DEclaration de chaines
    | LOOKAHEAD(3) affectation()
    | LOOKAHEAD(3) affectationString()         // Affectation de chaines
    | condition()
    | boucleTantQue()
    | bouclePour()
}

void declarationVariable() : {}
{
    <ENTIER> <IDENTIFIANT>
    {
        symbolTable.put(token.image, 0);
    }
}

void declarationVariableString() : {}
{
    "chaine" <IDENTIFIANT>
    {
        symbolTableString.put(token.image, "");
    }
}

void affectation() : { String varName; int value; }
{
    <IDENTIFIANT> { varName = token.image; } "<-" value = expression()
    {
        symbolTable.put(varName, value);
    }
}

void affectationString() : { String varName; }
{
    <IDENTIFIANT> { varName = token.image; } "<-" <STRING>
    {
        String value = token.image;
        symbolTableString.put(varName, value);
    }
}

void afficherInt() : { int value; }
{
    {
        System.out.println("-> Entree dans afficherInt");
    }
    <AFFICHERINT> "(" value = expression() ")"
    {
        System.out.println("Afficher (Int) : " + value);
    }
    {
        System.out.println("<- Sortie de afficherInt");
    }
}

void afficherString() : { String value; }
{
    {
        System.out.println("-> Entree dans afficherString");
    }
    <AFFICHERSTRING> "("
        (
            <STRING> { value = token.image; }
            | <IDENTIFIANT> {
                if (symbolTableString.containsKey(token.image)) {
                    value = symbolTableString.get(token.image);
                } else {
                    throw new Error("Variable non dEclarEe : " + token.image);
                }
            }
        )
    ")"
    {
        System.out.println("Afficher (String) : " + value);
    }
    {
        System.out.println("<- Sortie de afficherString");
    }
}

void lireInt() : {}
{
    {
        System.out.println("-> Entree dans lireInt");
    }
    <LIREINT> "(" <IDENTIFIANT> ")"
    {
        if (!symbolTable.containsKey(token.image)) {
            throw new Error("Variable non dEclarEe : " + token.image);
        }
        symbolTable.put(token.image, 42); // Exemple de valeur lue
    }
    {
        System.out.println("<- Sortie de lireInt");
    }
}

void lireString() : {}
{
    {
        System.out.println("-> Entree dans lireString");
    }
    <LIRESTRING> "(" <IDENTIFIANT> ")"
    {
        if (!symbolTableString.containsKey(token.image)) {
            throw new Error("Variable non dEclarEe : " + token.image);
        }
        symbolTableString.put(token.image, "exemple"); // Exemple de valeur lue
    }
    {
        System.out.println("<- Sortie de lireString");
    }
}

void condition() : {}
{
    {
        System.out.println("-> Entree dans condition");
    }
    <SI> expBool() <ALORS> instructions() [<SINON> instructions()] <FINSI>
    {
        System.out.println("<- Sortie de condition");
    }
}

void boucleTantQue() : {}
{
    {
        System.out.println("-> Entree dans boucleTantQue");
    }
    <TANTQUE> expBool() <FAIRE> instructions() <FINTANTQUE>
    {
        System.out.println("<- Sortie de boucleTantQue");
    }
}

void bouclePour() : {}
{
    {
        System.out.println("-> Entree dans bouclePour");
    }
    <POUR> <IDENTIFIANT> <DE> expArith() <A> expArith() <FAIRE> instructions() <FINPOUR>
    {
        System.out.println("<- Sortie de bouclePour");
    }
}

int expression() : { int result; }
{
    result = expArith() { return result; }
}

int expArith() : { int result; int term1, term2; }
{
    term1 = term()
    (
        "+" term2 = term() { result = term1 + term2; term1 = result; }
        | "-" term2 = term() { result = term1 - term2; term1 = result; }
    )*
    { return term1; }
}

int term() : { int result; int factor1, factor2; }
{
    factor1 = factor()
    (
        "*" factor2 = factor() { result = factor1 * factor2; factor1 = result; }
        | "/" factor2 = factor() {
            if (factor2 == 0) throw new ArithmeticException("Division par zero !");
            result = factor1 / factor2;
            factor1 = result;
        }
    )*
    { return factor1; }
}

int factor() : { int result; }
{
    <NUMBER> { result = Integer.parseInt(token.image); return result; }
    | <IDENTIFIANT> {
        if (symbolTable.containsKey(token.image)) {
            result = symbolTable.get(token.image);
        } else {
            throw new Error("Variable non dEclarEe : " + token.image);
        }
        return result;
    }
    | "(" result = expArith() ")" { return result; }
}

boolean expBool() : { boolean result; boolean right; }
{
    result = termBool()
    (
        "||" right = termBool() { result = result || right; }
    )*
    { return result; }
}

boolean termBool() : { boolean result; boolean right; }
{
    result = factorBool()
    (
        "&&" right = factorBool() { result = result && right; }
    )*
    { return result; }
}

boolean factorBool() : { boolean result; }
{
    "!" result = factorBool() { result = !result; }
    | { result = elementBool(); }
    { return result; }
}

boolean valueBool() : { boolean result; }
{
    <TRUE> { return true; }
    | <FALSE> { return false; }
}

boolean elementBool() : { boolean result; }
{
    LOOKAHEAD(3) "(" result = expBool() ")" { return result; }
    | LOOKAHEAD(2) comparison() { result = comparison(); }
    | LOOKAHEAD(1) <TRUE> { return true; }
    | LOOKAHEAD(1) <FALSE> { return false; }
}


boolean comparison() : { boolean result; int left, right; }
{
    left = expression()
    (
        <GT> right = expression() { result = left > right; }
        | <LT> right = expression() { result = left < right; }
        | <GE> right = expression() { result = left >= right; }
        | <LE> right = expression() { result = left <= right; }
        | <EQ> right = expression() { result = left == right; }
        | <NE> right = expression() { result = left != right; }
        | { throw new Error("Unsupported operator in comparison."); }
    )
    { return result; }
}
